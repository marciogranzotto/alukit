{
  "name": "alukit",
  "version": "0.0.0",
  "private": true,
  "description": "Plan aluminium-extrusion builds in the browser.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "alukit": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "node src/cli/main.ts serve",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "camera-controls": "3.1.2",
    "preact": "11.2.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
