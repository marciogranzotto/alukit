{
  "case": "G30",
  "rule": "a connector fits each joined bar by its role: a butting bar by its system, the through bar by its system or, when a mount's fastener set puts a sleeve in it, by its bore (§3.4)",
  "design": "a bush end on a T-slot bar butting into an RHS of no system: no error; the T-slot bar 575.00; one sleeve 42.00 (the bore across the RHS's 50, less two 4 mm walls); one bush and one connector. Two butting ends: two of each. Through a T-slot bar: a fit error on the through bar (a sleeve needs a hollow bar), the butting bar 580.00. A T-slot bracket with no sleeve on the RHS: a fit error on the RHS. The bush end on a flat bar of no system: a fit error on the flat bar only, and no fastener set applies, so no bush and no sleeve. A sleeve of a fixed length: cut as given, and refused in a T-slot through bar too. A joint recipe with the same mount: the same bush and sleeve, and no connector counted; the recipe is listed once",
  "expect": {
    "lines": {
      "test:TS40": [{ "count": 1, "cut_mm": 575 }],
      "test-geo:TUBE-18x2": [{ "count": 1, "cut_mm": 42 }]
    },
    "hardware": { "test-joint:BUSH-END": 1, "test-joint:BUSH-M8": 1 },
    "errors": []
  },
  "cases": [
    {
      "name": "two butting ends, one from each side",
      "patch": {
        "bars": {
          "b3": { "a": [500, -600, 0], "b": [500, 0, 0], "label": "T-slot 40x40 butting from -Y" }
        },
        "connections": { "c1": { "ends": ["b2.a", "b3.b"] } }
      },
      "expect": {
        "lines": {
          "test:TS40": [{ "count": 2, "cut_mm": 575 }],
          "test-geo:TUBE-18x2": [{ "count": 2, "cut_mm": 42 }]
        },
        "hardware": { "test-joint:BUSH-END": 2, "test-joint:BUSH-M8": 2 },
        "errors": []
      }
    },
    {
      "name": "through a T-slot bar",
      "patch": { "bars": { "b1": { "item": "test:TS40" } } },
      "expect": {
        "lines": { "test:TS40": [{ "count": 1, "cut_mm": 1000 }, { "count": 1, "cut_mm": 580 }] },
        "hardware": { "test-joint:BUSH-END": 1, "test-joint:BUSH-M8": 1 },
        "errors": [{ "code": "fit", "entity": "c1", "refs": ["b1"] }]
      }
    },
    {
      "name": "a T-slot bracket with no sleeve on the RHS",
      "patch": { "connections": { "c1": { "connector": "test-joint:BRK-T" } } },
      "expect": {
        "lines": { "test:TS40": [{ "count": 1, "cut_mm": 575 }] },
        "errors": [{ "code": "fit", "entity": "c1", "refs": ["b1"] }]
      }
    },
    {
      "name": "the bush end on a flat bar of no system",
      "patch": { "bars": { "b2": { "item": "test-geo:FB-50x10" } } },
      "expect": {
        "lines": { "test-geo:FB-50x10": [{ "count": 1, "cut_mm": 575 }] },
        "hardware": { "test-joint:BUSH-END": 1, "test-joint:BUSH-M8": 0 },
        "errors": [{ "code": "fit", "entity": "c1", "refs": ["b2"] }]
      }
    },
    {
      "name": "a sleeve of a fixed length",
      "patch": { "connections": { "c1": { "connector": "test-joint:BUSH-END-L" } } },
      "expect": {
        "lines": { "test-geo:TUBE-18x2": [{ "count": 1, "cut_mm": 40 }] },
        "hardware": { "test-joint:BUSH-END-L": 1, "test-joint:BUSH-M8": 1 },
        "errors": []
      }
    },
    {
      "name": "a joint recipe: the same bush and sleeve, and no body of its own",
      "patch": { "connections": { "c1": { "connector": "test-joint:BUSH-JOINT" } } },
      "expect": {
        "lines": { "test-geo:TUBE-18x2": [{ "count": 1, "cut_mm": 42 }] },
        "hardware": { "test-joint:BUSH-JOINT": 0, "test-joint:BUSH-M8": 1 },
        "recipes": { "test-joint:BUSH-JOINT": 1 },
        "errors": []
      }
    },
    {
      "name": "a sleeve of a fixed length, through a T-slot bar",
      "patch": {
        "bars": { "b1": { "item": "test:TS40" } },
        "connections": { "c1": { "connector": "test-joint:BUSH-END-L" } }
      },
      "expect": {
        "lines": { "test:TS40": [{ "count": 1, "cut_mm": 1000 }, { "count": 1, "cut_mm": 580 }] },
        "errors": [{ "code": "fit", "entity": "c1", "refs": ["b1"] }]
      }
    }
  ]
}
