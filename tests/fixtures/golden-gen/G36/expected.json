{
  "case": "G36",
  "rule": "a butt's end face must sit on the face it bears on: an overhang past it is a warning past a threshold, an overlap into the bar beyond it an error (§4.5, §5.5)",
  "design": "b2's 40 x 40 end face on b1's top face, flush: 1600 mm², no overhang, no overlap. 10 across: 10.00 past the face, 400 mm² of it outside, a connection warning; at b1's end, b1 not covering it: 20.00, 800 mm². With defaults.butt.overhang_mm 10 the 10 passes; a connector whose overhang_mm is 5 warns again. A 45° brace's end face, 40 x 56.57 = 2262.74 mm², lies on the face; pushed 2 in along its axis, it goes 2/√2 = 1.41 into b1: a connection error",
  "expect": {
    "butts": {
      "c1": [
        {
          "end": "b2.a",
          "on": "b1 +y",
          "area_mm2": 1600,
          "overhang_mm": 0,
          "overhang_mm2": 0,
          "overlap_mm": 0
        }
      ]
    },
    "warnings": [],
    "errors": []
  },
  "cases": [
    {
      "name": "10 across",
      "patch": { "bars": { "b2": { "a": [300, 10, 0], "b": [300, 10, 500] } } },
      "expect": {
        "butts": {
          "c1": [
            {
              "end": "b2.a",
              "on": "b1 +y",
              "area_mm2": 1600,
              "overhang_mm": 10,
              "overhang_mm2": 400,
              "overlap_mm": 0
            }
          ]
        },
        "warnings": [{ "code": "connection", "entity": "c1", "refs": ["b2", "b1"] }],
        "errors": []
      }
    },
    {
      "name": "at b1's end, not covering it",
      "patch": {
        "bars": { "b2": { "a": [600, 0, 0], "b": [600, 0, 500] } },
        "connections": { "c1": { "through_end": "node" } }
      },
      "expect": {
        "butts": {
          "c1": [
            {
              "end": "b2.a",
              "on": "b1 +y",
              "area_mm2": 1600,
              "overhang_mm": 20,
              "overhang_mm2": 800,
              "overlap_mm": 0
            }
          ]
        },
        "warnings": [{ "code": "connection", "entity": "c1", "refs": ["b2", "b1"] }],
        "errors": []
      }
    },
    {
      "name": "the project allows 10",
      "patch": {
        "defaults": { "butt": { "overhang_mm": 10 } },
        "bars": { "b2": { "a": [300, 10, 0], "b": [300, 10, 500] } }
      },
      "expect": {
        "butts": {
          "c1": [
            {
              "end": "b2.a",
              "on": "b1 +y",
              "area_mm2": 1600,
              "overhang_mm": 10,
              "overhang_mm2": 400,
              "overlap_mm": 0
            }
          ]
        },
        "warnings": [],
        "errors": []
      }
    },
    {
      "name": "a connector that allows 5",
      "patch": {
        "defaults": { "butt": { "overhang_mm": 10 } },
        "bars": { "b2": { "a": [300, 10, 0], "b": [300, 10, 500] } },
        "connections": { "c1": { "connector": "test-seat:OV5" } }
      },
      "expect": {
        "butts": {
          "c1": [
            {
              "end": "b2.a",
              "on": "b1 +y",
              "area_mm2": 1600,
              "overhang_mm": 10,
              "overhang_mm2": 400,
              "overlap_mm": 0
            }
          ]
        },
        "recipes": { "test-seat:OV5": 1 },
        "warnings": [{ "code": "connection", "entity": "c1", "refs": ["b2", "b1"] }],
        "errors": []
      }
    },
    {
      "name": "a 45° brace",
      "patch": { "bars": { "b2": { "b": [800, 0, 500], "ends": { "a": { "cut": "angle" } } } } },
      "expect": {
        "butts": {
          "c1": [
            {
              "end": "b2.a",
              "on": "b1 +y",
              "area_mm2": 2262.74,
              "overhang_mm": 0,
              "overhang_mm2": 0,
              "overlap_mm": 0
            }
          ]
        },
        "warnings": [],
        "errors": []
      }
    },
    {
      "name": "the brace pushed 2 in",
      "patch": {
        "bars": {
          "b2": { "b": [800, 0, 500], "ends": { "a": { "cut": "angle", "extend_mm": 2 } } }
        }
      },
      "expect": {
        "butts": {
          "c1": [
            {
              "end": "b2.a",
              "on": "b1 +y",
              "area_mm2": 2262.74,
              "overhang_mm": 0,
              "overhang_mm2": 0,
              "overlap_mm": 1.41
            }
          ]
        },
        "warnings": [],
        "errors": [{ "code": "connection", "entity": "c1", "refs": ["b2", "b1"] }]
      }
    }
  ]
}
